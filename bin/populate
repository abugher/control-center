#!/bin/bash
#
# It might be nice to have a repair mode that won't fail if some or all of the
# repos already exist.


function main() {
  change_dir

  branch="$(git branch | grep '^\*' | sed 's/^* //')" \
    || fail "Failed to find branch."

  configure_control_center
  populate_caches
  populate_superproject .
}


function change_dir() {
  bin_dir="${0%/*}"
  work_dir="${bin_dir}/.."

  cd "${work_dir}" \
    || fail "Failed to change directory."
}


function configure_control_center() {
  # Special handling for top level superproject "control-center".
  clone="https://github.com/abugher/control-center.git"
  pull="${clone}"
  push="git@github.com:abugher/control-center.git"

  configure_subproject
}


function populate_caches() {
  # These should all be listed in:  .gitignore
  repos_untracked=(
    ansible-common-tasks.git
    ansible-environment.git
    ansible-inventory.git
    certificate-authority.git
  )
  repos_untracked_sensitive=(
    sensitive-ansible-inventory.git
    sensitive-certificate-authority.git
  )

  for repo in "${repos_untracked[@]}"; do
    populate_cache "git@github.com:abugher/${repo}"
  done
  for repo in "${repos_untracked_sensitive[@]}"; do
    # Name of fileserver is hardcoded here.  Perhaps not ideal.
    populate_cache "ansible@files:/storage/control-center/${repo}"
  done
}


function populate_cache() {
  address="${1}"
  output "Populating cache:  repo='${repo}'; address='${address}'"
  git clone --bare "${address}" "${repo}" \
    || fail "Failed to clone repo:  '${repo}'"
  ( 
    cd "${repo}" \
      || fail "Failed to change directory to repo:  '${repo}'"
    git symbolic-ref HEAD refs/heads/"${branch}" \
      || fail "Failed to set branch:  '${branch}'"
    git push -u origin "${branch}" \
      || fail "Failed to set upstream for repo:  '${repo}'"
  ) || fail "Failed to set branch and upstream for repo:  '${repo}'"
}


function populate_superproject() {
  local superproject="${1}"
  if test '' = "${superproject}"; then
    fail "No superproject specified."
  fi

  if ! test -e "${superproject}/.gitmodules"; then
    return 0
  fi

  output "Populating superproject:  '${superproject}'"

  local subprojects=()
  unset paths_by_subproject
  declare -A paths_by_subproject
  unset urls_by_subproject
  declare -A urls_by_subproject
  # Parse the encoded submodule listing directly.  What could go wrong?
  while read line; do 
    if grep -q '^\[submodule' <<< "${line}"; then 
      subproject="$(awk -F '"' '{print $2}' <<< "${line}")"
      subprojects+=( "${subproject}" )
    elif grep -q '^ *path *=' <<< "${line}"; then 
      path="$(sed 's/ *path *= *//' <<< "${line}")"
      paths_by_subproject["${subproject}"]="${path}"
    elif grep -q '^ *url *=' <<< "${line}"; then 
      url="$(sed 's/ *url *= *//' <<< "${line}")"
      urls_by_subproject["${subproject}"]="${url}"
    fi
  done < "${superproject}/.gitmodules"

  for subproject in "${subprojects[@]}"; do
    url="${urls_by_subproject[${subproject}]}"
    path="${superproject}/${paths_by_subproject[${subproject}]}"
    if test '' = "${url}"; then
      fail "No URL for subproject:  '${subproject}'"
    elif test "${superproject}/" = "${path}"; then
      fail "No path for subproject:  '${subproject}'"
    fi

    # Each cache repo is handled specially.  Path must match exactly; trailing
    # slashes will break matching.
    case "${path}" in
      'environment')
        populate_subproject_from_cache '../../../ansible-environment.git'
        ;;
      'tasks/common')
        populate_subproject_from_cache '../../../../ansible-common-tasks.git'
        ;;
      'inventory')
        populate_subproject_from_cache '../../../ansible-environment.git'
        ;;
      'sensitive-inventory')
        populate_subproject_from_cache '../../../sensitive-ansible-environment.git'
        ;;
      'certificate-authority')
        populate_subproject_from_cache '../../../certificate-authority.git'
        ;;
      'sensitive-certificate-authority')
        populate_subproject_from_cache '../../../sensitive-certificate-authority.git'
        ;;
      *)
        # Not a cached repo.
        populate_subproject_from_url
        ;;
    esac


  done

  (
    cd "${superproject}" \
      || fail "Failed to enter superproject directory."
    git submodule update \
      || fail "Failed to update subprojects."
  ) || fail "Failed to sync subprojects to specified versions for superproject:  '${superproject}'"


  for subproject in "${subprojects[@]}"; do
    # Recurse.
    output "Attempting to populate as a superproject:  '${subproject}'"
    populate_superproject "${superproject}/${subproject}"
  done
}


function populate_subproject_from_cache() {
  output "Populating subproject from cache:  path='${path}'; cache_path='${cache_path}'"
  cache="${1}"
  clone="${cache_path}"
  pull="${cache_path}"
  push="${cache_path}"
  populate_subproject
}


function populate_subproject_from_url() {
  output "Populating subproject from submodule URL:  path='${path}'; url='${url}'"
  repo_name="${url##*/}"
  clone="${url}"
  pull="${url}"
  push="git@github.com:abugher/${repo_name}"
  populate_subproject
}


populate_subproject() {
  mkdir -p "${path}" \
    || fail "Failed to create subproject directory:  '${path}'"
  (
    cd "${path}" \
      || fail "Failed to enter subproject directory:  '${path}'"
    git clone "${clone}" ./ \
      || fail "Failed to clone repo from:  '${clone}'"
    configure_subproject
  ) || fail "Failed to populate subproject:  '${path}'"
}


function configure_subproject() {
  git remote set-url origin "${pull}" \
    || fail "Failed to set pull URL to:  '${pull}'"
  git remote set-url --push origin "${push}" \
    || fail "Failed to set push URL to:  '${push}'"
  git checkout "${branch}" \
    || fail "Failed to check out branch:  '${branch}'"
  git push -u origin "${branch}" \
    || fail "Failed to set upstream to branch:  '${branch}'"
}


function output() {
  printf '%s\n' "${1}"
}


function fail() {
  output "Error:  ${1}" >&2
  exit "${2:-1}"
}


function warn() {
  output "Warning:  ${1}" >&2
}


main "${@}"
