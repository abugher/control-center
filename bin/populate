#!/bin/bash
#
# It might be nice to have a repair mode that won't fail if some or all of the
# repos already exist.


function main() {
  change_dir

  branch="$(git branch | grep '^\*' | sed 's/^* //')" \
    || fail "Failed to find branch."

  configure_control_center
  populate_caches
  populate_superproject .
}


function change_dir() {
  bin_dir="${0%/*}"
  work_dir="${bin_dir}/.."

  cd "${work_dir}" \
    || fail "Failed to change directory."
}


function configure_control_center() {
  # Special handling for top level superproject "control-center".
  clone="https://github.com/abugher/control-center.git"
  pull="${clone}"
  push="git@github.com:abugher/control-center.git"

  configure_subproject
}


function populate_caches() {
  cache_repos=(
    ansible-common-tasks
  )

  mkdir -p cache \
    || fail "Failed to create cache directory."

  if ! grep -q '^cache$' .gitignore; then
    fail "Cache directory (cache) is not listed in file:  .gitignore"
  fi

  for repo_base_name in "${cache_repos[@]}"; do
    repo_url="git@github.com:abugher/${repo_base_name}.git"
    populate_cache 
  done
}


function populate_cache() {
  repo_bare="${repo_base_name}.git"
  repo_sync="${repo_base_name}.sync"
  output "Populating cache:  repo_bare='${repo_bare}'; repo_url='${repo_url}'"
  git clone --bare "${repo_url}" "cache/${repo_bare}" \
    || fail "Failed to clone repo:  '${repo_bare}'"
  ( 
    cd "cache/${repo_bare}" \
      || fail "Failed to change directory to cache (bare) repo:  '${repo_bare}'"
    git symbolic-ref HEAD refs/heads/"${branch}" \
      || fail "Failed to set branch:  '${branch}'"
    git push -u origin "${branch}" \
      || fail "Failed to set upstream for cache (bare) repo:  '${repo_bare}'"
  ) || fail "Failed to set branch and upstream for cache (bare) repo:  '${repo_bare}'"


  output "Populating sync repo:  '${repo_sync}'"
  # Go ahead and take advantage of the brand new local cache.
  git clone "cache/${repo_bare}" "cache/${repo_sync}" \
    || fail "Failed to create sync repo:  '${repo_sync}'"
  (
    cd "cache/${repo_sync}" \
      || fail "Failed to enter sync repo."
    git remote set-url origin "${repo_url}" \
      || fail "Failed to set pull URL for sync repo to address:  '${repo_url}'"
    git remote set-url --push origin "../${repo_bare}" \
      || fail "Failed to set push URL for sync repo to path:  '${repo_bare}'"
    git checkout "${branch}" \
      || fail "Failed to checkout branch for sync repo:  '${branch}'"
    git push -u origin "${branch}" \
      || fail "Failed to set upstream for sync repo:  '${repo_bare}'"
  ) || fail "Failed to populate and configure sync repo:  '${repo_sync}'"
}


function populate_superproject() {
  local superproject="${1}"

  if test '' = "${superproject}"; then
    fail "No superproject specified."
  fi

  if ! test -e "${superproject}/.gitmodules"; then
    output "No submodule definitions; skipping:  "${superproject}""
    return 0
  fi

  output "Populating superproject:  '${superproject}'"

  local subprojects=()
  unset paths_by_subproject
  declare -A paths_by_subproject
  unset urls_by_subproject
  declare -A urls_by_subproject
  # Parse the encoded submodule listing directly.  What could go wrong?
  while read line; do 
    if grep -q '^\[submodule' <<< "${line}"; then 
      subproject="$(awk -F '"' '{print $2}' <<< "${line}")"
      subprojects+=( "${subproject}" )
    elif grep -q '^ *path *=' <<< "${line}"; then 
      paths_by_subproject["${subproject}"]="$(
        sed 's/ *path *= *//' <<< "${line}"
      )"
    elif grep -q '^ *url *=' <<< "${line}"; then 
      urls_by_subproject["${subproject}"]="$(
        sed 's/ *url *= *//' <<< "${line}"
      )"
    fi
  done < "${superproject}/.gitmodules"

  for subproject in "${subprojects[@]}"; do
    if test '' = "${subproject}"; then
      fail "Empty string listed as subproject."
    fi
    url="${urls_by_subproject[${subproject}]}"
    path_short="${paths_by_subproject[${subproject}]}"
    path_long="${superproject}/${path_short}"
    path="${path_long}"
    if test '' = "${url}"; then
      fail "No URL for subproject:  '${subproject}'"
    elif test '' = "${path_short}"; then
      fail "No path for subproject:  '${subproject}'"
    fi

    # Each cache repo is handled specially.  Path must match exactly; trailing
    # slashes will break matching.
    case "${path_short}" in
      'environment')
        populate_subproject_from_cache '../../../cache/ansible-environment.git'
        ;;
      'tasks/common')
        populate_subproject_from_cache '../../../../cache/ansible-common-tasks.git'
        ;;
      *)
        # Not a cached repo.
        populate_subproject_from_url
        ;;
    esac
  done

  (
    cd "${superproject}" \
      || fail "Failed to enter superproject directory."
    git submodule update \
      || fail "Failed to update subprojects."
  ) || fail "Failed to sync subprojects to specified versions for superproject:  '${superproject}'"


  for subproject in "${subprojects[@]}"; do
    # Recurse.
    if test '' = "${subproject}"; then
      fail "Empty string listed as subproject."
    fi
    path_short="${paths_by_subproject[${subproject}]}"
    path_long="${superproject}/${path_short}"
    output "Attempting to populate as a superproject:  '${path_long}'"

    # Recursion seems to break associative arrays, even though `declare` is
    # supposed to create local scope when used inside a function.  Creating a
    # subshell seems to prevent this problem.
    ( populate_superproject "${path_long}"; ) \
      || fail "Failed to populate superproject:  '${path_long}'"

  done
}


function populate_subproject_from_cache() {
  cache_path="${1}"
  cache="${1}"
  clone="${cache_path}"
  pull="${cache_path}"
  push="${cache_path}"
  populate_subproject
}


function populate_subproject_from_url() {
  repo_name="${url##*/}"
  clone="${url}"
  pull="${url}"
  if grep -q '^https://github.com/' <<< "${pull}"; then
    push="git@github.com:abugher/${repo_name}"
  else
    push="${pull}"
  fi
  populate_subproject
}


populate_subproject() {
  output "Populating subproject path:  '${path_long}'"
  mkdir -p "${path_long}" \
    || fail "Failed to create subproject directory:  '${path_long}'"
  (
    cd "${path_long}" \
      || fail "Failed to enter subproject directory:  '${path_long}'"
    git clone "${clone}" ./ \
      || fail "Failed to clone repo from:  '${clone}'"
    configure_subproject
  ) || fail "Failed to populate subproject:  '${path_long}'"
}


function configure_subproject() {
  git remote set-url origin "${pull}" \
    || fail "Failed to set pull URL to:  '${pull}'"
  git remote set-url --push origin "${push}" \
    || fail "Failed to set push URL to:  '${push}'"
  git checkout "${branch}" \
    || fail "Failed to check out branch:  '${branch}'"
  git push -u origin "${branch}" \
    || fail "Failed to set upstream to branch:  '${branch}'"
}


function output() {
  printf '%s\n' "${1}"
}


function fail() {
  output "Error:  ${1}" >&2
  exit "${2:-1}"
}


function warn() {
  output "Warning:  ${1}" >&2
}


function debug() {
  var="${1}"
  output "DEBUG:  ${var}='${!var}'"
}


main "${@}"
